;; Optional config for spell.web namespace.
;; Search auto-selects :serper when SERPER_API_KEY env var is set.
;; Override with {:search {:backend :serper}} or {:search {:backend :duckduckgo}}.
;; Serper API key: set SERPER_API_KEY env var or :serper-api-key below.

{:search {:max-results 5
          :region "us-en"}

 :fetch {:backend :jina
         :max-chars 40000
         :timeout-ms 15000
         :fallback-backend :raw}

 :http {:user-agent "spell-web/0.1 (+https://github.com/loconnor/spell)"}}
