;; Optional config for spell.web namespace.
;; Safe default: DuckDuckGo search + Jina fetch + raw fallback.

{:search {:backend :duckduckgo
          :max-results 5
          :region "us-en"}

 :fetch {:backend :jina
         :max-chars 40000
         :timeout-ms 15000
         :fallback-backend :raw}

 :http {:user-agent "spell-web/0.1 (+https://github.com/loconnor/spell)"}}
