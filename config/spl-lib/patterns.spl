;; Spell Pattern Library
;;
;; Reusable patterns for common Spell idioms.
;; Available as patterns namespace: (patterns/check-result prompt answer)

;; ---------------------------------------------------------------------------
;; check-result — verify answer with LLM-as-judge
;; ---------------------------------------------------------------------------
;; Uses leaf-llm to verify whether an answer is correct. Returns a tagged map
;; that the caller can dispatch on to decide what to do next.
;;
;; (patterns/check-result "What is 2+2?" 4)        ; => {:ok 4}
;; (patterns/check-result "Capital of France?" "London")  ; => {:wrong "London is..."}
;;
;; Returns:
;;   {:ok answer}   - answer is correct, caller should use it
;;   {:wrong msg}   - answer is wrong, msg explains why; caller decides how to fix
;;
;; Typical usage pattern:
;;   (let [result (patterns/check-result prompt my-answer)]
;;     (if (:ok result)
;;       (:ok result)
;;       (llm (cat (reopen completion)
;;                 "(def feedback " (pr-str (:wrong result)) ") "))))

(defn check-result [prompt answer]
  (let [verification-prompt (cat "Verify this answer.\n\n"
                                 "Task: " prompt "\n\n"
                                 "Answer: " (pr-str answer) "\n\n"
                                 "Respond with exactly one line:\n"
                                 "- \"OK\" if correct\n"
                                 "- \"WRONG: <reason>\" if incorrect")
        response (leaf-llm verification-prompt)
        trimmed (strings/trim response)]
    (if (strings/starts-with? trimmed "OK")
      {:ok answer}
      {:wrong (strings/trim
               (if (strings/starts-with? trimmed "WRONG:")
                 (strings/subs trimmed 6)
                 trimmed))})))

;; ---------------------------------------------------------------------------
;; clean-prompt — clean up raw text and execute
;; ---------------------------------------------------------------------------
;; Passes raw input (voice-to-text, quick notes, typos) through leaf-llm to
;; infer intent and produce a clear prompt, then executes it via !llm-self.
;;
;; (quine prompt "waht is the captal of franc... like the big city")
;; '(patterns/clean-prompt prompt)
;;
;; Also works with a plain string:
;; '(patterns/clean-prompt "fix teh bug in main.py, the one where it crashs on empty input")

(defn clean-prompt [raw]
  (let [text (if (string? raw) raw (pr-str raw))
        cleaned (leaf-llm (cat "Rewrite the following as a clear, well-formed prompt. "
                               "Fix typos, complete half-sentences, and infer intent. "
                               "The input may be wrapped in code syntax — ignore that and focus on the natural language content. "
                               "Output ONLY the rewritten prompt.\n\n"
                               text))]
    (!llm-self cleaned)))

;; ---------------------------------------------------------------------------
;; explore — one-shot codebase exploration via child agent
;; ---------------------------------------------------------------------------
;; Spawns a child exploration agent that investigates the codebase using
;; grep, read-file, read-lines, etc. and returns structured findings.
;;
;; '(!call-now findings (patterns/explore "Where is authentication handled?"))
;; => {:answer "Authentication is in src/auth.py..." :files ["src/auth.py"]}
;;
;; The child agent has access to io/ tools and returns a map with:
;;   :answer  - string summary of findings
;;   :files   - vector of relevant file paths

(defn explore [query]
  (agents/!spawn-ask !llm-self
    (cat "You are an exploration agent. Your task is to investigate the codebase and return structured findings.\n\n"
         "Use io/sh with grep, find, and io/read-file or io/read-lines to explore.\n"
         "Return a map with :answer (string summary) and :files (vector of relevant file paths).\n\n"
         "Query: " query)))

;; ---------------------------------------------------------------------------
;; ralph - retry orchestration in a future (caller stays responsive)
;; ---------------------------------------------------------------------------
;; Spawns a worker and runs retry orchestration in a future thread:
;; send task -> blocking/send-await -> test -> retry.
;;
;; '(!call-now started (patterns/ralph "fix the failing test"))
;; => returns immediately; later sends {:pass result} or {:fail last-result}
;;    to the calling agent.
;;
;; opts:
;;   string                  - task text
;;   {:task "..."            - required task text (or provide string arg)
;;    :test-fn fn            - truthy means pass (default: (:ok result))
;;    :max-retries int       - default 3
;;    :worker-prompt string} - custom worker prompt
;;
(defn ralph [opts]
  (let [opts (if (string? opts) {:task opts} opts)
        task (or (:task opts) (throw "ralph: :task required"))
        test-fn (or (:test-fn opts) (fn [result] (:ok result)))
        max-retries (or (:max-retries opts) 3)
        worker-prompt (or (:worker-prompt opts)
                          (str "You are a worker agent for patterns/ralph.\n"
                               "On each wake, inspect the newest msg-* binding.\n"
                               "Read :body {:kind :task|:retry ...} and produce an improved result.\n"
                               "Do not send messages to parent; return your result as completion value."))
        me (agents/current-handle)
        worker-handle (read-string (str ":ralph-worker-" (abs (rand-int 1000000))))
        worker (agents/spawn worker-prompt worker-handle)]
    (future
      (let [final-result
            (loop [attempt 0
                   feedback {:kind :task :body task :attempt 0}]
              (let [result (blocking/send-await worker feedback)]
                (if (test-fn result)
                  {:pass result}
                  (if (>= (inc attempt) max-retries)
                    {:fail result}
                    (recur (inc attempt)
                           {:kind :retry
                            :attempt (inc attempt)
                            :task task
                            :previous result
                            :feedback (str "Test failed, retry with a better result. Previous: "
                                           (pr-str result))}))))) ]
        (agents/send me final-result)))
    {:started true :worker worker}))


;; ---------------------------------------------------------------------------
;; team - planner + wave scheduler + worktree-isolated workers + verifier
;; ---------------------------------------------------------------------------

(defn team-read-literal [raw]
  (if (string? raw)
    (try
      (read-string raw)
      (catch e raw))
    raw))

(defn team-parse-task-vector [raw]
  (let [parsed (patterns/team-read-literal raw)]
    (if (vector? parsed)
      parsed
      (if (string? raw)
        (let [match (re-find "(?s)\\[[\\s\\S]*\\]" raw)
              matched (if match (patterns/team-read-literal match) nil)]
          (if (vector? matched) matched raw))
        raw))))

(defn team-normalize-id [idx raw-id]
  (cond
    (keyword? raw-id) raw-id
    (symbol? raw-id) (keyword (name raw-id))
    (and (string? raw-id)
         (not (strings/blank? raw-id))
         (re-matches "^[A-Za-z0-9._/-]+$" raw-id))
    (keyword raw-id)
    :else
    (keyword (str "task-" (inc idx)))))

(defn team-normalize-dep [raw-dep]
  (cond
    (keyword? raw-dep) raw-dep
    (symbol? raw-dep) (keyword (name raw-dep))
    (and (string? raw-dep)
         (not (strings/blank? raw-dep))
         (re-matches "^[A-Za-z0-9._/-]+$" raw-dep))
    (keyword raw-dep)
    :else nil))

(defn team-normalize-task [idx task default-max-retries]
  (let [task-map (if (map? task) task {})
        id (patterns/team-normalize-id idx (:id task-map))
        title-raw (:title task-map)
        title (if (and (string? title-raw)
                       (not (strings/blank? title-raw)))
                title-raw
                (str "Task " (inc idx)))
        context-raw (:context task-map)
        context (if (and (string? context-raw)
                         (not (strings/blank? context-raw)))
                  context-raw
                  (pr-str context-raw))
        deps-raw (if (sequential? (:depends task-map)) (:depends task-map) [])]
    {:id id
     :title title
     :context context
     :depends (vec (keep patterns/team-normalize-dep deps-raw))
     :status :pending
     :attempt 0
     :max-retries (if (number? (:max-retries task-map))
                    (:max-retries task-map)
                    default-max-retries)
     :slot (inc idx)
     :feedback ""
     :result nil
     :branch nil
     :worktree nil
     :worker nil
     :error nil
     :verification nil}))

(defn team-validate-tasks [tasks]
  (let [id-groups (group-by :id tasks)
        dup-id (first (keep (fn [[id group]]
                              (when (> (count group) 1) id))
                            id-groups))
        id-set (set (map :id tasks))
        missing-dep
        (first
         (keep (fn [task]
                 (let [missing
                       (first
                        (remove (fn [dep] (contains? id-set dep))
                                (:depends task)))]
                   (when missing
                     {:task task :dep missing})))
               tasks))
        self-dep
        (first
         (filter (fn [task]
                   (contains? (set (:depends task)) (:id task)))
                 tasks))]
    (cond
      (empty? tasks)
      {:ok false
       :feedback "Return at least one task."}

      dup-id
      {:ok false
       :feedback (str "Task ids must be unique. Duplicate id: " dup-id)}

      missing-dep
      {:ok false
       :feedback (str "Task " (get-in missing-dep [:task :id])
                      " depends on unknown task " (:dep missing-dep))}

      self-dep
      {:ok false
       :feedback (str "Task " (:id self-dep) " cannot depend on itself.")}

      :else
      {:ok true :tasks tasks})))

(defn team-quote-shell [s]
  (pr-str (str s)))

(defn team-in-dir [path cmd]
  (io/sh (str "cd " (patterns/team-quote-shell path) " && " cmd)))

(defn team-maybe-commit [path message]
  (let [status (:out (patterns/team-in-dir path "git status --porcelain"))]
    (when (not (strings/blank? status))
      (patterns/team-in-dir path "git add -A")
      (patterns/team-in-dir path (str "git commit -m " (patterns/team-quote-shell message)))))
  true)

(defn team-collect-git-state [path]
  (str "PATH: " path "\n\n"
       "GIT STATUS:\n"
       (:out (patterns/team-in-dir path "git status --short"))
       "\n\nGIT DIFF (unstaged):\n"
       (:out (patterns/team-in-dir path "git diff"))
       "\n\nGIT DIFF (staged):\n"
       (:out (patterns/team-in-dir path "git diff --cached"))
       "\n\nUNMERGED FILES:\n"
       (:out (patterns/team-in-dir path "git diff --name-only --diff-filter=U"))))

(defn team-conflicted? [path]
  (not (strings/blank? (:out (patterns/team-in-dir path "git diff --name-only --diff-filter=U")))))

(defn team-merge-in-progress? [path]
  (= 0 (:exit (patterns/team-in-dir path "git rev-parse -q --verify MERGE_HEAD"))))

(defn team-abort-merge [path]
  (when (patterns/team-merge-in-progress? path)
    (patterns/team-in-dir path "git merge --abort"))
  (patterns/team-in-dir path "git reset --hard HEAD")
  (patterns/team-in-dir path "git clean -fd")
  true)

(defn team-remove-worktree-branch [repo-root worktree-path branch]
  (when (and worktree-path (io/exists? worktree-path))
    (patterns/team-in-dir repo-root
                 (str "git worktree remove --force "
                      (patterns/team-quote-shell worktree-path))))
  (when branch
    (patterns/team-in-dir repo-root
                 (str "git branch -D " (patterns/team-quote-shell branch))))
  true)

(defn team-extract-summary [result]
  (if (and (string? result)
           (not (strings/blank? result)))
    result
    (if (and (map? result)
             (string? (:summary result))
             (not (strings/blank? (:summary result))))
      (:summary result)
      nil)))

(defn team-default-commit-msg [task]
  (str "team: " (:title task)))

(defn team-normalize-review [raw task]
  (let [parsed (patterns/team-read-literal raw)]
    (if (map? parsed)
      (let [approved (:approved parsed)
            summary-raw (:summary parsed)
            commit-raw (:commit-msg parsed)]
        (if (or (= true approved) (= false approved))
          {:ok true
           :approved approved
           :summary (if (and (string? summary-raw)
                             (not (strings/blank? summary-raw)))
                      summary-raw
                      (if approved
                        (str "Approved " (:title task))
                        (str "Rejected " (:title task))))
           :commit-msg (if (and (string? commit-raw)
                                (not (strings/blank? commit-raw)))
                         commit-raw
                         (patterns/team-default-commit-msg task))
           :retry (= true (:retry parsed))
           :resolved-conflict (= true (:resolved-conflict parsed))}
          {:ok false
           :feedback (str "Verifier must return {:approved true|false ...}. Raw response:\n"
                          (pr-str raw))}))
      {:ok false
       :feedback (str "Verifier must return a Spell map literal. Raw response:\n"
                      (pr-str raw))})))

(defn team-review-merge [verifier-handle base-msg task]
  (loop [feedback ""
         attempt 0]
    (let [raw (blocking/send-await verifier-handle (assoc base-msg :feedback feedback))
          review (patterns/team-normalize-review raw task)]
      (if (:ok review)
        review
        (if (>= attempt 2)
          {:ok true
           :approved false
           :summary (:feedback review)
           :commit-msg (patterns/team-default-commit-msg task)
           :retry false
           :resolved-conflict false}
          (recur (:feedback review) (inc attempt)))))))

(defn team-plan-tasks [planner-handle goal shared-context default-max-retries]
  (loop [feedback ""
         attempt 0]
    (let [raw (blocking/send-await planner-handle
                                   {:kind :plan
                                    :goal goal
                                    :shared-context shared-context
                                    :feedback feedback})
          parsed (patterns/team-parse-task-vector raw)
          normalized (if (vector? parsed)
                       (map-indexed (fn [idx task]
                                      (patterns/team-normalize-task idx task default-max-retries))
                                    parsed)
                       nil)
          validation (if normalized
                       (patterns/team-validate-tasks normalized)
                       {:ok false
                        :feedback (str "Return ONLY a Spell vector of task maps. Raw response:\n"
                                       (pr-str raw))})]
      (if (:ok validation)
        validation
        (if (>= attempt 2)
          {:ok false
           :fail (:feedback validation)}
          (recur (:feedback validation) (inc attempt)))))))

(defn team-replace-task [tasks updated-task]
  (map (fn [task]
         (if (= (:id task) (:id updated-task))
           updated-task
           task))
       tasks))

(defn team-mark-blocked [tasks]
  (let [failed-ids (set (map :id (filter (fn [task] (= :failed (:status task))) tasks)))]
    (map (fn [task]
           (if (and (= :pending (:status task))
                    (some (fn [dep] (contains? failed-ids dep))
                          (:depends task)))
             (assoc task
                    :status :failed
                    :error (str "Blocked by failed dependency for " (:id task)))
             task))
         tasks)))

(defn team-ready-tasks [tasks]
  (let [completed-ids (set (map :id (filter (fn [task] (= :completed (:status task))) tasks)))]
    (filter (fn [task]
              (and (= :pending (:status task))
                   (every? (fn [dep] (contains? completed-ids dep))
                           (:depends task))))
            tasks)))

(defn team [goal-or-opts]
  (let [opts (if (string? goal-or-opts) {:goal goal-or-opts} goal-or-opts)
        goal-raw (:goal opts)
        goal (if (string? goal-raw) goal-raw (pr-str goal-raw))
        shared-context-raw (:shared-context opts)
        shared-context (if (and (string? shared-context-raw)
                                (not (strings/blank? shared-context-raw)))
                         shared-context-raw
                         "")
        max-retries (if (number? (:max-retries opts)) (:max-retries opts) 2)
        run-id (abs (rand-int 1000000))
        branch (str "spell-team-" run-id)
        worktree-base (str "/tmp/spell-team-" run-id)
        repo-root (strings/trim (:out (io/sh "git rev-parse --show-toplevel")))
        orig-branch (strings/trim (:out (io/sh "git rev-parse --abbrev-ref HEAD")))
        orig-checkout (if (= orig-branch "HEAD")
                        (strings/trim (:out (io/sh "git rev-parse HEAD")))
                        orig-branch)
        orig-checkout-cmd (if (= orig-branch "HEAD")
                            (str "git checkout --detach "
                                 (patterns/team-quote-shell orig-checkout))
                            (str "git checkout "
                                 (patterns/team-quote-shell orig-checkout)))
        dirty? (not (strings/blank? (:out (io/sh "git status --porcelain"))))
        planner-handle (read-string (str ":team-planner-" run-id))
        verifier-handle (read-string (str ":team-verifier-" run-id))
        io-guide
        (let [docs (:docs io)
              guide (:guide docs)]
          (if (string? guide) guide ""))
        io-guide-context
        (if (strings/blank? io-guide)
          ""
          (str "\n\nIO namespace guide:\n"
               io-guide
               "\n\nUse absolute paths or prefix shell commands with the provided worktree path.\n"))
        planner-init-prompt
        (str "You are the planner agent in patterns/team.\n\n"
             "On each wake, inspect the newest msg-* binding.\n"
             "Its :body has keys:\n"
             "{:kind :plan :goal str :shared-context str :feedback str}\n\n"
             "Return ONLY a Spell vector literal of task maps.\n"
             "Each task map must have:\n"
             "{:id :task-name :title \"short title\" :context \"worker instructions\" :depends [:task-a ...]}\n\n"
             "Planning rules:\n"
             "- Break the goal into the smallest useful independently executable tasks\n"
             "- Use :depends only for real prerequisites\n"
             "- Keep :context specific enough for an isolated worker to act without extra planning\n"
             "- Re-use shared context inside each task where relevant\n"
             "- If feedback is non-empty, fix your previous plan and return a corrected vector only\n")
        planner-init-completion
        (str "(quine completion (eval (do "
             "(quine prompt " (pr-str planner-init-prompt) ") "
             "'(!extend))))")
        verifier-init-prompt
        (str "You are the verifier agent in patterns/team.\n\n"
             "On each wake, inspect the newest msg-* binding.\n"
             "Its :body has keys:\n"
             "{:kind :verify|:commit-failed\n"
             " :goal str :shared-context str :task map :task-branch str :worker-result any\n"
             " :integration-path str :merge-status keyword :merge-output str :git-state str\n"
             " :feedback str}\n\n"
             "You review the integration branch AFTER the scheduler attempted the merge.\n"
             "If :merge-status is :conflict, you may edit files in :integration-path to resolve conflicts.\n"
             "Stage resolved files with git add when needed.\n"
             "Approve only if the integrated state is acceptable for this task.\n"
             "Reject if the change is incorrect, incomplete, or should be retried.\n"
             io-guide-context
             "Return ONLY a Spell map literal with keys:\n"
             "{:approved true|false\n"
             " :summary \"what you checked or why you rejected\"\n"
             " :commit-msg \"commit message for approved merge\"\n"
             " :retry true|false\n"
             " :resolved-conflict true|false}\n")
        verifier-init-completion
        (str "(quine completion (eval (do "
             "(quine prompt " (pr-str verifier-init-prompt) ") "
             "'(!extend))))")
        worker-init-prompt
        (str "You are a task worker in patterns/team.\n\n"
             "On each wake, inspect the newest msg-* binding.\n"
             "Its :body has keys:\n"
             "{:kind :task :goal str :shared-context str :task map :attempt int\n"
             " :feedback str :worktree-path str :integration-branch str}\n\n"
             "Do your implementation work ONLY inside :worktree-path.\n"
             "Prefix shell commands with: cd <worktree-path> && ...\n"
             "Do not create git commits, switch branches, or merge branches; the scheduler owns git orchestration.\n"
             "You may read and edit files, run focused commands, and inspect tests in the worktree.\n"
             "Return either a brief summary string or {:summary \"...\"} describing what changed.\n"
             io-guide-context)
        worker-init-completion
        (str "(quine completion (eval (do "
             "(quine prompt " (pr-str worker-init-prompt) ") "
             "'(!extend))))")]
    (if (strings/blank? goal)
      {:fail "team requires non-empty :goal"}
      (do
        (when dirty?
          (io/sh "git add -A")
          (io/sh "git commit -m \"baseline: pre-team state\""))
        (io/sh (str "git checkout -b " branch))
        (io/mkdirs worktree-base)
        (agents/register planner-handle planner-init-completion)
        (agents/register verifier-handle verifier-init-completion)
        (futures/!ask-await
         (future
           (let [plan-result (patterns/team-plan-tasks planner-handle goal shared-context max-retries)]
             (if (not (:ok plan-result))
               (do
                 (patterns/team-in-dir repo-root orig-checkout-cmd)
                 (patterns/team-in-dir repo-root (str "git branch -D " (patterns/team-quote-shell branch)))
                 {:status :failed
                  :summary (:fail plan-result)
                  :tasks []})
               (let [final-tasks
                     (loop [tasks (:tasks plan-result)]
                       (let [tasks (vec (patterns/team-mark-blocked tasks))
                             ready (vec (patterns/team-ready-tasks tasks))]
                         (if (empty? ready)
                           (if (every? (fn [task]
                                         (or (= :completed (:status task))
                                             (= :failed (:status task))))
                                       tasks)
                             tasks
                             (vec
                              (map (fn [task]
                                     (if (= :pending (:status task))
                                       (assoc task
                                              :status :failed
                                              :error (str "No executable tasks remain for " (:id task)))
                                       task))
                                   tasks)))
                           (let [wave
                                 (map (fn [task]
                                        (let [attempt-num (inc (:attempt task))
                                              worker-handle
                                              (read-string
                                               (str ":team-worker-" run-id "-"
                                                    (:slot task) "-a" attempt-num))
                                              task-branch
                                              (str branch "-task-" (:slot task) "-a" attempt-num)
                                              worktree-path
                                              (str worktree-base "/task-" (:slot task) "-a" attempt-num)
                                              _ (agents/register worker-handle worker-init-completion)
                                              _ (patterns/team-in-dir repo-root
                                                             (str "git worktree add -b "
                                                                  (patterns/team-quote-shell task-branch)
                                                                  " "
                                                                  (patterns/team-quote-shell worktree-path)
                                                                  " "
                                                                  (patterns/team-quote-shell branch)))
                                              token (blocking/completion-promise worker-handle)
                                              _ (agents/send worker-handle
                                                             {:kind :task
                                                              :goal goal
                                                              :shared-context shared-context
                                                              :task task
                                                              :attempt attempt-num
                                                              :feedback (:feedback task)
                                                              :worktree-path worktree-path
                                                              :integration-branch branch})]
                                          {:task (assoc task
                                                        :status :in-progress
                                                        :attempt attempt-num
                                                        :branch task-branch
                                                        :worktree worktree-path
                                                        :worker worker-handle)
                                           :token token}))
                                      ready)
                                 tasks-in-flight
                                 (reduce (fn [acc entry]
                                           (patterns/team-replace-task acc (:task entry)))
                                         tasks
                                         wave)
                                 wave-results
                                 (blocking/await-all (map :token wave))
                                 tasks-next
                                 (reduce
                                  (fn [acc idx]
                                    (let [entry (nth wave idx)
                                          task (:task entry)
                                          worker-result (nth wave-results idx)
                                          worker-summary (patterns/team-extract-summary worker-result)
                                          _ (patterns/team-maybe-commit (:worktree task)
                                                               (str "team worker: " (:title task)
                                                                    " (attempt " (:attempt task) ")"))
                                          merge-result
                                          (patterns/team-in-dir repo-root
                                                       (str "git merge --no-commit --no-ff "
                                                            (patterns/team-quote-shell (:branch task))))
                                          merge-status
                                          (if (patterns/team-conflicted? repo-root)
                                            :conflict
                                            (if (= 0 (:exit merge-result))
                                              :clean
                                              :merge-failed))
                                          review-msg
                                          {:kind :verify
                                           :goal goal
                                           :shared-context shared-context
                                           :task task
                                           :task-branch (:branch task)
                                           :worker-result worker-result
                                           :integration-path repo-root
                                           :merge-status merge-status
                                           :merge-output (str "EXIT: " (:exit merge-result)
                                                              "\nOUT:\n" (:out merge-result)
                                                              "\nERR:\n" (:err merge-result))
                                           :git-state (patterns/team-collect-git-state repo-root)}
                                          review (patterns/team-review-merge verifier-handle review-msg task)]
                                      (if (:approved review)
                                        (let [_ (patterns/team-in-dir repo-root "git add -A")
                                              status-before-commit
                                              (:out (patterns/team-in-dir repo-root "git status --porcelain"))
                                              commit-result
                                              (if (strings/blank? status-before-commit)
                                                {:exit 0 :out "" :err ""}
                                                (patterns/team-in-dir repo-root
                                                             (str "git commit -m "
                                                                  (patterns/team-quote-shell (:commit-msg review)))))
                                              commit-status-after
                                              (:out (patterns/team-in-dir repo-root "git status --porcelain"))
                                              commit-review
                                              (if (or (= 0 (:exit commit-result))
                                                      (strings/blank? commit-status-after))
                                                review
                                                (patterns/team-review-merge
                                                 verifier-handle
                                                 {:kind :commit-failed
                                                  :goal goal
                                                  :shared-context shared-context
                                                  :task task
                                                  :task-branch (:branch task)
                                                  :worker-result worker-result
                                                  :integration-path repo-root
                                                  :merge-status :commit-failed
                                                  :merge-output (str "EXIT: " (:exit commit-result)
                                                                     "\nOUT:\n" (:out commit-result)
                                                                     "\nERR:\n" (:err commit-result))
                                                  :git-state (patterns/team-collect-git-state repo-root)}
                                                 task))
                                              _ (if (and (not (= 0 (:exit commit-result)))
                                                         (:approved commit-review)
                                                         (not (strings/blank? commit-status-after)))
                                                  (do
                                                    (patterns/team-in-dir repo-root "git add -A")
                                                    (patterns/team-in-dir repo-root
                                                                 (str "git commit -m "
                                                                      (patterns/team-quote-shell (:commit-msg commit-review)))))
                                                  true)
                                              final-status
                                              (:out (patterns/team-in-dir repo-root "git status --porcelain"))
                                              approved? (and (not= :merge-failed merge-status)
                                                             (strings/blank? final-status))]
                                          (patterns/team-remove-worktree-branch repo-root
                                                                       (:worktree task)
                                                                       (:branch task))
                                          (patterns/team-replace-task
                                           acc
                                           (if approved?
                                             (assoc task
                                                    :status :completed
                                                    :result worker-result
                                                    :feedback ""
                                                    :error nil
                                                    :verification (:summary commit-review))
                                             (do
                                               (patterns/team-abort-merge repo-root)
                                               (if (< (:attempt task) (:max-retries task))
                                                 (assoc task
                                                        :status :pending
                                                        :feedback (:summary commit-review)
                                                        :result worker-result
                                                        :branch nil
                                                        :worktree nil
                                                        :worker nil
                                                        :verification (:summary commit-review))
                                                 (assoc task
                                                        :status :failed
                                                        :error (:summary commit-review)
                                                        :result worker-result
                                                        :verification (:summary commit-review)))))))
                                        (do
                                          (patterns/team-abort-merge repo-root)
                                          (patterns/team-remove-worktree-branch repo-root
                                                                       (:worktree task)
                                                                       (:branch task))
                                          (patterns/team-replace-task
                                           acc
                                           (if (< (:attempt task) (:max-retries task))
                                             (assoc task
                                                    :status :pending
                                                    :feedback (:summary review)
                                                    :result worker-result
                                                    :branch nil
                                                    :worktree nil
                                                    :worker nil
                                                    :verification (:summary review))
                                             (assoc task
                                                    :status :failed
                                                    :error (:summary review)
                                                    :result worker-result
                                                    :verification (:summary review))))))))
                                  tasks-in-flight
                                  (range (count wave)))]
                             (recur (vec tasks-next))))))]
                 (let [completed (filter (fn [task] (= :completed (:status task))) final-tasks)
                       failed (filter (fn [task] (= :failed (:status task))) final-tasks)
                       status (if (empty? failed)
                                :completed
                                (if (empty? completed) :failed :partial))
                       failed-ids (vec (map :id failed))
                       summary (str (count completed) " completed, "
                                    (count failed) " failed")]
                   (when (= status :failed)
                     (patterns/team-in-dir repo-root orig-checkout-cmd)
                     (patterns/team-in-dir repo-root (str "git branch -D " (patterns/team-quote-shell branch))))
                   {:status status
                    :tasks final-tasks
                    :summary summary
                    :branch (if (= status :failed) nil branch)
                    :failed failed-ids}))))))))))


;; ---------------------------------------------------------------------------
;; fix-loop - test-driven code fixing with persistent reflector + worker agents
;; ---------------------------------------------------------------------------
;; Manages a git-backed retry loop for code repair.
;; Registers two dormant agents for the run:
;; - reflector agent (diagnosis + test authoring)
;; - worker agent (targeted code edits)
;;
;; The root loop runs inside a future and uses blocking/send-await for both roles.
;;
;; '(!call-now result (patterns/fix-loop
;;    issue-description))
;; => {:pass true} or {:fail "reason"}
;;
;; primary argument:
;;   issue - issue description string (required)
;;
;; optional map form (advanced/internal use):
;;   {:issue "..."
;;    :max-retries 5}
;;
;; Reflector must return a map-like value with:
;;   {:resolved true|false :diagnosis "..." :test "..." :panic false}
;;
;; Notes:
;; - The reflector writes/updates tests and decides when issue is resolved.
;; - Dirty state is committed before branch creation to preserve user work.
;; - Reflector artifacts are committed before each worker call as rollback points.
;;
(defn fix-loop [issue-or-opts]
  (let [opts             (if (map? issue-or-opts)
                           issue-or-opts
                           {:issue issue-or-opts})
        issue-raw        (:issue opts)
        issue            (if (string? issue-raw) issue-raw (pr-str issue-raw))
        max-retries      (or (:max-retries opts) 5)
        run-id           (abs (rand-int 1000000))
        branch           (str "spell-fix-" run-id)
        reflector-handle (read-string (str ":fix-reflector-" run-id))
        worker-handle    (read-string (str ":fix-worker-" run-id))
        orig-branch      (strings/trim (:out (io/sh "git rev-parse --abbrev-ref HEAD")))
        reset-worktree   (fn []
                           (io/sh "git reset --hard HEAD")
                           (io/sh "git clean -fd"))
        cleanup          (fn []
                           (reset-worktree)
                           (io/sh (str "git checkout " orig-branch)))
        maybe-commit     (fn [msg]
                           (when (not (strings/blank? (:out (io/sh "git status --porcelain"))))
                             (io/sh "git add -A")
                             (io/sh (str "git commit -m \"" msg "\""))))
        dirty?           (not (strings/blank? (:out (io/sh "git status --porcelain"))))]
    (if (strings/blank? issue)
      {:fail "fix-loop requires non-empty issue description"}
      (let [normalize-reflector
            (fn [raw]
              (let [parsed (if (map? raw)
                             raw
                             (if (string? raw)
                               (try
                                 (read-string raw)
                                 (catch e raw))
                               raw))]
                (if (not (map? parsed))
                  {:ok false
                   :feedback (str "Invalid reflector response. Return a Spell map literal with keys "
                                  ":resolved, :diagnosis, :test, :panic.\n"
                                  "Raw response:\n"
                                  (pr-str raw))}
                  (let [panic? (= true (:panic parsed))
                        diagnosis-raw (:diagnosis parsed)
                        diagnosis (if (string? diagnosis-raw)
                                    diagnosis-raw
                                    (if (nil? diagnosis-raw) "" (pr-str diagnosis-raw)))
                        test-cmd (:test parsed)
                        resolved (:resolved parsed)]
                    (if panic?
                      {:ok true
                       :panic true
                       :diagnosis (if (strings/blank? diagnosis)
                                    "Reflector set :panic true without diagnosis."
                                    diagnosis)}
                      (let [errors-0 []
                            errors-1 (if (or (= true resolved) (= false resolved))
                                       errors-0
                                       (conj errors-0 ":resolved must be true or false"))
                            errors-2 (if (strings/blank? diagnosis)
                                       (conj errors-1 ":diagnosis must be a non-empty string")
                                       errors-1)
                            errors-3 (if (and (string? test-cmd)
                                              (not (strings/blank? test-cmd)))
                                       errors-2
                                       (conj errors-2 ":test must be a non-empty shell command"))
                            has-errors (not (empty? errors-3))
                            error-text (apply str (map (fn [x] (str "- " x "\n")) errors-3))]
                        (if has-errors
                          {:ok false
                           :feedback (str "Invalid reflector schema.\n"
                                          error-text
                                          "Raw response:\n"
                                          (pr-str raw))}
                          {:ok true
                           :panic false
                           :resolved resolved
                           :diagnosis diagnosis
                           :test test-cmd})))))))
            collect-diff
            (fn []
              (str "GIT STATUS:\n"
                   (:out (io/sh "git status --short"))
                   "\n\nGIT DIFF (unstaged):\n"
                   (:out (io/sh "git diff"))
                   "\n\nGIT DIFF (staged):\n"
                   (:out (io/sh "git diff --cached"))))
            run-gate
            (fn [active-test]
              (let [primary (io/sh active-test)]
                {:pass (= 0 (:exit primary))
                 :cmd active-test
                 :result primary}))
            format-test-result
            (fn [cmd result]
              (str "COMMAND: " cmd "\n"
                   "EXIT: " (:exit result) "\n"
                   "OUT:\n" (:out result) "\n"
                   "ERR:\n" (:err result)))
            reflector-msg
            (fn [attempt last-test-output last-diff last-diagnosis active-test last-worker-summary feedback]
              {:kind :reflect
               :attempt attempt
               :issue issue
               :active-test active-test
               :last-test-output last-test-output
               :last-diff last-diff
               :last-diagnosis last-diagnosis
               :last-worker-summary last-worker-summary
               :feedback feedback})
            extract-worker-summary
            (fn [worker-result]
              (if (and (string? worker-result)
                       (not (strings/blank? worker-result)))
                worker-result
                (if (and (map? worker-result)
                         (string? (:summary worker-result))
                         (not (strings/blank? (:summary worker-result))))
                  (:summary worker-result)
                  nil)))
            io-guide
            (let [docs (:docs io)
                  guide (:guide docs)]
              (if (string? guide) guide ""))
            io-guide-context
            (if (strings/blank? io-guide)
              ""
              (str "\n\nIO namespace guide:\n"
                   io-guide
                   "\n\nPrefer io/ APIs and signatures exactly as documented above.\n"))
            reflector-init-prompt
            (str "You are the reflector agent in patterns/fix-loop.\n\n"
                 "On each wake, inspect the newest msg-* binding.\n"
                 "Its :body has keys:\n"
                 "{:kind :reflect :attempt int :issue str :active-test str|nil\n"
                 " :last-test-output str :last-diff str :last-diagnosis str\n"
                 " :last-worker-summary str|nil :feedback str}\n\n"
                 "You own diagnosis and test strategy. The worker only applies edits.\n\n"
                 "Contract:\n"
                 "1) Return :resolved false only when issue is NOT fixed yet.\n"
                 "2) When :resolved false, :test must currently FAIL.\n"
                 "3) Return :resolved true only when issue IS fixed.\n"
                 "4) When :resolved true, :test must currently PASS.\n"
                 "5) Harness checks this strictly: test-pass must equal :resolved.\n"
                 "6) If mismatch or invalid schema, you will be re-prompted with :feedback.\n"
                 "7) Harness commits reflector artifacts before worker edits.\n"
                 "   If worker edits are bad, you can roll back with git reset --hard HEAD.\n"
                 "8) After every worker call, you get post-worker test output + diff + worker summary.\n"
                 "9) Reflector owns final decision to continue, resolve, or panic.\n\n"
                 io-guide-context
                 "Return ONLY a Spell map literal with exactly:\n"
                 "{:resolved true|false\n"
                 " :diagnosis \"why issue is or is not resolved\"\n"
                 " :test \"shell command to validate your claim\"\n"
                 " :panic false}\n\n"
                 "Set :panic true only if fundamentally unsolvable; include diagnosis.")
            reflector-init-completion
            (str "(quine completion (eval (do "
                 "(quine prompt " (pr-str reflector-init-prompt) ") "
                 "'(!extend))))")
            worker-init-prompt
            (str "You are a code repair worker used by patterns/fix-loop.\n\n"
                 "On each wake, inspect the newest msg-* binding.\n"
                 "Its :body is a map with keys:\n"
                 "{:kind :repair :attempt int :issue str :diagnosis str :test str\n"
                 " :failed-cmd str :failed-output str}\n\n"
                 "Use :issue + :diagnosis to make targeted implementation edits.\n"
                 "Use io/sh, io/read-file, io/str-replace, and io/write-file as needed.\n"
                 "Do NOT run tests; parent loop runs tests.\n"
                 io-guide-context
                 "Return either:\n"
                 "- nil/no summary, or\n"
                 "- a brief summary (string or {:summary \"...\"}) describing what changed and why it should fix diagnosis.")
            worker-init-completion
            (str "(quine completion (eval (do "
                 "(quine prompt " (pr-str worker-init-prompt) ") "
                 "'(!extend))))")]
        (when dirty?
          (io/sh "git add -A")
          (io/sh "git commit -m \"baseline: pre-fix-loop state\""))
        (io/sh (str "git checkout -b " branch))
        (agents/register reflector-handle reflector-init-completion)
        (agents/register worker-handle worker-init-completion)
        (futures/!ask-await
          (future
            (loop [attempt 0
                   last-test-output ""
                   last-diff ""
                   last-diagnosis ""
                   active-test nil
                   last-worker-summary nil
                   feedback ""]
              (let [reflector-raw (blocking/send-await reflector-handle
                                                       (reflector-msg attempt
                                                                      last-test-output
                                                                      last-diff
                                                                      last-diagnosis
                                                                      active-test
                                                                      last-worker-summary
                                                                      feedback))
                    reflector (normalize-reflector reflector-raw)]
                (cond
                  (not (:ok reflector))
                  (recur attempt
                         last-test-output
                         last-diff
                         last-diagnosis
                         active-test
                         last-worker-summary
                         (:feedback reflector))

                  (:panic reflector)
                  (do
                    (cleanup)
                    {:fail (:diagnosis reflector)})

                  :else
                  (let [diagnosis (:diagnosis reflector)
                        chosen-test (:test reflector)
                        resolved (:resolved reflector)
                        check (run-gate chosen-test)
                        check-pass (:pass check)
                        check-output (format-test-result (:cmd check) (:result check))]
                    (cond
                      (not (= check-pass resolved))
                      (let [mismatch-feedback
                            (str "Expected test pass == resolved flag.\n"
                                 "Reflector said :resolved " resolved
                                 " but test pass was " check-pass ".\n"
                                 "If :resolved is false, :test must fail.\n"
                                 "If :resolved is true, :test must pass.\n\n"
                                 check-output)]
                        (recur attempt
                               check-output
                               (collect-diff)
                               diagnosis
                               chosen-test
                               last-worker-summary
                               mismatch-feedback))

                      resolved
                      (do
                        (maybe-commit (str "fix-loop: resolved (worker attempts " attempt ")"))
                        {:pass true
                         :diagnosis diagnosis
                         :last-worker-summary last-worker-summary})

                      (>= attempt max-retries)
                      (do
                        (cleanup)
                        {:fail (str "Max worker retries (" max-retries "). Last diagnosis: " diagnosis
                                    (if last-worker-summary
                                      (str ". Last worker summary: " last-worker-summary)
                                      ""))})

                      :else
                      (let [pre-output check-output]
                        ;; Checkpoint reflector-authored tests/diagnosis artifacts so
                        ;; reflector can roll back worker edits with git reset --hard HEAD.
                        (maybe-commit (str "fix-loop: reflector checkpoint (attempt " (inc attempt) ")"))
                        (let [worker-result (blocking/send-await
                                             worker-handle
                                             {:kind :repair
                                              :attempt (inc attempt)
                                              :issue issue
                                              :diagnosis diagnosis
                                              :test chosen-test
                                              :failed-cmd (:cmd check)
                                              :failed-output pre-output})
                              worker-summary (extract-worker-summary worker-result)
                              post-check (run-gate chosen-test)
                              post-output
                              (str (format-test-result (:cmd post-check) (:result post-check))
                                   "\n\nWORKER RESULT:\n"
                                   (pr-str worker-result))
                              attempt-diff (collect-diff)]
                          (recur (inc attempt)
                                 post-output
                                 attempt-diff
                                  diagnosis
                                 chosen-test
                                 worker-summary
                                 ""))))))))))))))
