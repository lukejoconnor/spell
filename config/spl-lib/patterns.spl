;; Spell Pattern Library
;;
;; Reusable patterns for common Spell idioms.
;; Available as patterns namespace: (patterns/check-result prompt answer)

;; ---------------------------------------------------------------------------
;; check-result — verify answer with LLM-as-judge
;; ---------------------------------------------------------------------------
;; Uses leaf-llm to verify whether an answer is correct. Returns a tagged map
;; that the caller can dispatch on to decide what to do next.
;;
;; (patterns/check-result "What is 2+2?" 4)        ; => {:ok 4}
;; (patterns/check-result "Capital of France?" "London")  ; => {:wrong "London is..."}
;;
;; Returns:
;;   {:ok answer}   - answer is correct, caller should use it
;;   {:wrong msg}   - answer is wrong, msg explains why; caller decides how to fix
;;
;; Typical usage pattern:
;;   (let [result (patterns/check-result prompt my-answer)]
;;     (if (:ok result)
;;       (:ok result)
;;       (llm (cat (reopen completion)
;;                 "(def feedback " (pr-str (:wrong result)) ") "))))

(defn check-result [prompt answer]
  (let [verification-prompt (cat "Verify this answer.\n\n"
                                 "Task: " prompt "\n\n"
                                 "Answer: " (pr-str answer) "\n\n"
                                 "Respond with exactly one line:\n"
                                 "- \"OK\" if correct\n"
                                 "- \"WRONG: <reason>\" if incorrect")
        response (leaf-llm verification-prompt)
        trimmed (strings/trim response)]
    (if (strings/starts-with? trimmed "OK")
      {:ok answer}
      {:wrong (strings/trim
               (if (strings/starts-with? trimmed "WRONG:")
                 (strings/subs trimmed 6)
                 trimmed))})))

;; ---------------------------------------------------------------------------
;; clean-prompt — clean up raw text and execute
;; ---------------------------------------------------------------------------
;; Passes raw input (voice-to-text, quick notes, typos) through leaf-llm to
;; infer intent and produce a clear prompt, then executes it via !llm-self.
;;
;; (quine prompt "waht is the captal of franc... like the big city")
;; '(patterns/clean-prompt prompt)
;;
;; Also works with a plain string:
;; '(patterns/clean-prompt "fix teh bug in main.py, the one where it crashs on empty input")

(defn clean-prompt [raw]
  (let [text (if (string? raw) raw (pr-str raw))
        cleaned (leaf-llm (cat "Rewrite the following as a clear, well-formed prompt. "
                               "Fix typos, complete half-sentences, and infer intent. "
                               "The input may be wrapped in code syntax — ignore that and focus on the natural language content. "
                               "Output ONLY the rewritten prompt.\n\n"
                               text))]
    (!llm-self cleaned)))

;; ---------------------------------------------------------------------------
;; explore — one-shot codebase exploration via child agent
;; ---------------------------------------------------------------------------
;; Spawns a child exploration agent that investigates the codebase using
;; grep, read-file, read-lines, etc. and returns structured findings.
;;
;; '(!call-now findings (patterns/explore "Where is authentication handled?"))
;; => {:answer "Authentication is in src/auth.py..." :files ["src/auth.py"]}
;;
;; The child agent has access to io/ tools and returns a map with:
;;   :answer  - string summary of findings
;;   :files   - vector of relevant file paths

(defn explore [query]
  (agents/!spawn-ask !llm-self
    (cat "You are an exploration agent. Your task is to investigate the codebase and return structured findings.\n\n"
         "Use io/sh with grep, find, and io/read-file or io/read-lines to explore.\n"
         "Return a map with :answer (string summary) and :files (vector of relevant file paths).\n\n"
         "Query: " query)))

;; ---------------------------------------------------------------------------
;; ralph - retry orchestration in a future (caller stays responsive)
;; ---------------------------------------------------------------------------
;; Spawns a worker and runs retry orchestration in a future thread:
;; send task -> blocking/send-await -> test -> retry.
;;
;; '(!call-now started (patterns/ralph "fix the failing test"))
;; => returns immediately; later sends {:pass result} or {:fail last-result}
;;    to the calling agent.
;;
;; opts:
;;   string                  - task text
;;   {:task "..."            - required task text (or provide string arg)
;;    :test-fn fn            - truthy means pass (default: (:ok result))
;;    :max-retries int       - default 3
;;    :worker-prompt string} - custom worker prompt
;;
(defn ralph [opts]
  (let [opts (if (string? opts) {:task opts} opts)
        task (or (:task opts) (throw "ralph: :task required"))
        test-fn (or (:test-fn opts) (fn [result] (:ok result)))
        max-retries (or (:max-retries opts) 3)
        worker-prompt (or (:worker-prompt opts)
                          (str "You are a worker agent for patterns/ralph.\n"
                               "On each wake, inspect the newest msg-* binding.\n"
                               "Read :body {:kind :task|:retry ...} and produce an improved result.\n"
                               "Do not send messages to parent; return your result as completion value."))
        me (agents/current-handle)
        worker-handle (read-string (str ":ralph-worker-" (abs (rand-int 1000000))))
        worker (agents/spawn worker-prompt worker-handle)]
    (future
      (let [final-result
            (loop [attempt 0
                   feedback {:kind :task :body task :attempt 0}]
              (let [result (blocking/send-await worker feedback)]
                (if (test-fn result)
                  {:pass result}
                  (if (>= (inc attempt) max-retries)
                    {:fail result}
                    (recur (inc attempt)
                           {:kind :retry
                            :attempt (inc attempt)
                            :task task
                            :previous result
                            :feedback (str "Test failed, retry with a better result. Previous: "
                                           (pr-str result))}))))) ]
        (agents/send me final-result)))
    {:started true :worker worker}))


;; ---------------------------------------------------------------------------
;; fix-loop - test-driven code fixing with persistent reflector + worker agents
;; ---------------------------------------------------------------------------
;; Manages a git-backed retry loop for code repair.
;; Registers two dormant agents for the run:
;; - reflector agent (diagnosis + test authoring)
;; - worker agent (targeted code edits)
;;
;; The root loop runs inside a future and uses blocking/send-await for both roles.
;;
;; '(!call-now result (patterns/fix-loop
;;    issue-description))
;; => {:pass true} or {:fail "reason"}
;;
;; primary argument:
;;   issue - issue description string (required)
;;
;; optional map form (advanced/internal use):
;;   {:issue "..."
;;    :max-retries 5}
;;
;; Reflector must return a map-like value with:
;;   {:diagnosis "..." :test "..." :panic false}
;;
;; Notes:
;; - The reflector writes/updates tests and proposes the active test command.
;; - Dirty state is committed before branch creation to preserve user work.
;; - Failed worker attempts are reset before retry for branch safety.
;;
(defn fix-loop [issue-or-opts]
  (let [opts             (if (map? issue-or-opts)
                           issue-or-opts
                           {:issue issue-or-opts})
        issue-raw        (:issue opts)
        issue            (if (string? issue-raw) issue-raw (pr-str issue-raw))
        max-retries      (or (:max-retries opts) 5)
        run-id           (abs (rand-int 1000000))
        branch           (str "spell-fix-" run-id)
        reflector-handle (read-string (str ":fix-reflector-" run-id))
        worker-handle    (read-string (str ":fix-worker-" run-id))
        orig-branch      (strings/trim (:out (io/sh "git rev-parse --abbrev-ref HEAD")))
        reset-worktree   (fn []
                           (io/sh "git reset --hard HEAD")
                           (io/sh "git clean -fd"))
        cleanup          (fn []
                           (reset-worktree)
                           (io/sh (str "git checkout " orig-branch)))
        maybe-commit     (fn [msg]
                           (when (not (strings/blank? (:out (io/sh "git status --porcelain"))))
                             (io/sh "git add -A")
                             (io/sh (str "git commit -m \"" msg "\""))))
        dirty?           (not (strings/blank? (:out (io/sh "git status --porcelain"))))]
    (if (strings/blank? issue)
      {:fail "fix-loop requires non-empty issue description"}
      (let [normalize-reflector
            (fn [raw previous-test]
              (let [parsed (if (map? raw)
                             raw
                             (if (string? raw)
                               (try
                                 (read-string raw)
                                 (catch e raw))
                               raw))
                    parsed (if (map? parsed)
                             parsed
                             {:diagnosis (str "Invalid reflector response: " (pr-str raw))
                              :test previous-test
                              :panic true})
                    diagnosis-base (if (string? (:diagnosis parsed))
                                     (:diagnosis parsed)
                                     (pr-str (:diagnosis parsed)))
                    test-cmd (if (and (string? (:test parsed))
                                      (not (strings/blank? (:test parsed))))
                               (:test parsed)
                               previous-test)
                    missing-test? (or (not (string? test-cmd))
                                      (strings/blank? test-cmd))
                    diagnosis (if missing-test?
                                (str diagnosis-base
                                     "\n\nReflector must return a non-empty :test command.")
                                diagnosis-base)]
                {:diagnosis diagnosis
                 :test test-cmd
                 :panic (or (= true (:panic parsed))
                            missing-test?)}))
            collect-diff
            (fn []
              (str "GIT STATUS:\n"
                   (:out (io/sh "git status --short"))
                   "\n\nGIT DIFF (unstaged):\n"
                   (:out (io/sh "git diff"))
                   "\n\nGIT DIFF (staged):\n"
                   (:out (io/sh "git diff --cached"))))
            run-gate
            (fn [active-test]
              (let [primary (io/sh active-test)]
                (if (not= 0 (:exit primary))
                  {:pass false
                   :failed-cmd active-test
                   :result primary}
                  {:pass true})))
            format-failure
            (fn [failed-cmd result]
              (str "COMMAND: " failed-cmd "\n"
                   "EXIT: " (:exit result) "\n"
                   "OUT:\n" (:out result) "\n"
                   "ERR:\n" (:err result)))
            reflector-msg
            (fn [attempt last-test-output last-diff last-diagnosis active-test]
              {:kind :reflect
               :attempt attempt
               :issue issue
               :active-test active-test
               :last-test-output last-test-output
               :last-diff last-diff
               :last-diagnosis last-diagnosis})
            io-guide
            (let [docs (:docs io)
                  guide (:guide docs)]
              (if (string? guide) guide ""))
            io-guide-context
            (if (strings/blank? io-guide)
              ""
              (str "\n\nIO namespace guide:\n"
                   io-guide
                   "\n\nPrefer io/ APIs and signatures exactly as documented above.\n"))
            reflector-init-prompt
            (str "You are the reflector agent in patterns/fix-loop.\n\n"
                 "On each wake, inspect the newest msg-* binding.\n"
                 "Its :body is a map with keys:\n"
                 "{:kind :reflect :attempt int :issue str :active-test str|nil\n"
                 " :last-test-output str :last-diff str :last-diagnosis str}\n\n"
                 "Responsibilities:\n"
                 "1) Attempt 0: explore codebase and run relevant existing tests FIRST.\n"
                 "2) Prefer an existing failing test command when it already reproduces the issue.\n"
                 "3) Only write/update a new regression test if no existing test reproduces the bug.\n"
                 "4) :test must cover relevant existing behavior, not only a newly added narrow test.\n"
                 "5) Run the exact :test command and ensure it FAILS before returning.\n"
                 "6) Retry attempts: use prior test output and diff to refine diagnosis and test command.\n"
                 "7) Reflector owns diagnosis and tests; do not implement production fixes.\n\n"
                 io-guide-context
                 "Return ONLY a Spell map literal with exactly:\n"
                 "{:diagnosis \"what is wrong and how to fix it\"\n"
                 " :test \"shell command to evaluate the fix\"\n"
                 " :panic false}\n\n"
                 ":test is REQUIRED and must be a runnable shell command.\n"
                 "Set :panic true only if fundamentally unsolvable.")
            reflector-init-completion
            (str "(quine completion (eval (do "
                 "(quine prompt " (pr-str reflector-init-prompt) ") "
                 "'(!extend))))")
            worker-init-prompt
            (str "You are a code repair worker used by patterns/fix-loop.\n\n"
                 "On each wake, inspect the newest msg-* binding.\n"
                 "Its :body is a map with keys:\n"
                 "{:kind :repair :attempt int :issue str :diagnosis str :test str\n"
                 " :failed-cmd str :failed-output str}\n\n"
                 "Use :issue + :diagnosis to make targeted implementation edits.\n"
                 "Use io/sh, io/read-file, io/str-replace, and io/write-file as needed.\n"
                 "Do NOT run tests; parent loop runs tests.\n"
                 io-guide-context
                 "Return a brief summary (string or {:summary \"...\"}).")
            worker-init-completion
            (str "(quine completion (eval (do "
                 "(quine prompt " (pr-str worker-init-prompt) ") "
                 "'(!extend))))")]
        (when dirty?
          (io/sh "git add -A")
          (io/sh "git commit -m \"baseline: pre-fix-loop state\""))
        (io/sh (str "git checkout -b " branch))
        (agents/register reflector-handle reflector-init-completion)
        (agents/register worker-handle worker-init-completion)
        (futures/!ask-await
          (future
            (loop [attempt 0
                   last-test-output ""
                   last-diff ""
                   last-diagnosis ""
                   active-test nil]
              (if (>= attempt max-retries)
                (do
                  (cleanup)
                  {:fail (str "Max retries (" max-retries "). Last diagnosis: " last-diagnosis)})
                (let [reflector-raw (blocking/send-await reflector-handle
                                                         (reflector-msg attempt
                                                                        last-test-output
                                                                        last-diff
                                                                        last-diagnosis
                                                                        active-test))
                      reflector (normalize-reflector reflector-raw active-test)
                      diagnosis (:diagnosis reflector)
                      chosen-test (:test reflector)]
                  (if (:panic reflector)
                    (do
                      (cleanup)
                      {:fail diagnosis})
                    (let [pre-check (run-gate chosen-test)]
                      (if (:pass pre-check)
                        (do
                          (maybe-commit (str "fix-loop: resolved before worker (attempt " (inc attempt) ")"))
                          {:pass true})
                        (let [pre-result (:result pre-check)
                              pre-failed-cmd (:failed-cmd pre-check)
                              pre-output (format-failure pre-failed-cmd pre-result)]
                          ;; Checkpoint reflector-authored tests/diagnosis artifacts so
                          ;; worker rollback can discard attempt-local edits.
                          (maybe-commit (str "fix-loop: reflector checkpoint (attempt " (inc attempt) ")"))
                          (let [worker-result (blocking/send-await
                                               worker-handle
                                               {:kind :repair
                                                :attempt (inc attempt)
                                                :issue issue
                                                :diagnosis diagnosis
                                                :test chosen-test
                                                :failed-cmd pre-failed-cmd
                                                :failed-output pre-output})
                                post-check (run-gate chosen-test)]
                            (if (:pass post-check)
                              (do
                                (maybe-commit (str "fix-loop: applied fix (attempt " (inc attempt) ")"))
                                {:pass true})
                              (let [post-result (:result post-check)
                                    post-failed-cmd (:failed-cmd post-check)
                                    post-output
                                    (str (format-failure post-failed-cmd post-result)
                                         "\n\nWORKER RESULT:\n"
                                         (pr-str worker-result))
                                    attempt-diff (collect-diff)]
                                (reset-worktree)
                                (recur (inc attempt)
                                       post-output
                                       attempt-diff
                                       diagnosis
                                       chosen-test)))))))))))))))))
