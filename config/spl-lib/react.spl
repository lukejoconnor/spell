;; React pattern — ReAct loop with bash actions, proper multi-turn messages.
;; Mirrors mini-swe-agent DefaultAgent: system + user + alternating assistant/user messages.
;; Loaded as react/ namespace via src/spell/react.clj.
;;
;; Usage: (react/run "Fix the failing test in test_foo.py")
;; Returns: {:exit_status "submitted"|"LimitsExceeded" :submission str}

;; react-system-prompt: agent instructions and few-shot examples
(defn react-system-prompt []
  (cat
    "You are a ReAct agent that solves tasks by running bash commands.\n\n"
    "Each response must be exactly:\n"
    "Thought N: <your reasoning>\n"
    "Action N: Bash[command] or Finish[answer]\n\n"
    "Rules:\n"
    "- Commands must be single-line. Use printf with \\n escapes to write multi-line files.\n"
    "- Never use heredoc (EOF) syntax.\n"
    "- Use Finish[answer] when you have the final answer.\n\n"
    "Examples:\n\n"
    "User: Task: How many .clj files are in src/?\n"
    "Assistant: Thought 1: I need to count .clj files in src/.\n"
    "Action 1: Bash[find src/ -name \"*.clj\" | wc -l]\n"
    "User: Observation 1: Exit code: 0\n24\n"
    "Assistant: Thought 2: There are 24 .clj files.\n"
    "Action 2: Finish[24]\n\n"
    "User: Task: Write hello world to /tmp/hello.py and run it.\n"
    "Assistant: Thought 1: I'll use printf to write the file, then run it.\n"
    "Action 1: Bash[printf 'print(\"Hello, world!\")\\n' > /tmp/hello.py && python3 /tmp/hello.py]\n"
    "User: Observation 1: Exit code: 0\nHello, world!\n"
    "Assistant: Thought 2: Script ran successfully.\n"
    "Action 2: Finish[Done. /tmp/hello.py written and verified.]"))

;; react-extract-thought: find "Thought N: ..." line in raw response
(defn react-extract-thought [raw step]
  (let [prefix (cat "Thought " (str step) ": ")
        lines  (strings/split raw "\n")]
    (loop [ls lines]
      (if (empty? ls)
        (strings/trim raw)
        (let [l (strings/trim (first ls))]
          (if (strings/starts-with? l prefix)
            (subs l (count prefix))
            (recur (rest ls))))))))

;; react-extract-action-line: find "Action N: ..." line in raw response
(defn react-extract-action-line [raw step]
  (let [prefix (cat "Action " (str step) ": ")
        lines  (strings/split raw "\n")]
    (loop [ls lines]
      (if (empty? ls)
        ""
        (let [l (strings/trim (first ls))]
          (if (strings/starts-with? l prefix)
            (subs l (count prefix))
            (recur (rest ls))))))))

;; react-parse-action: "Bash[cmd]" | "Finish[answer]" -> {:type :payload}
(defn react-parse-action [line]
  (let [t (strings/trim line)]
    (cond
      (strings/starts-with? t "Bash[")
        {:type :bash   :payload (subs t 5 (- (count t) 1))}
      (strings/starts-with? t "Finish[")
        {:type :finish :payload (subs t 7 (- (count t) 1))}
      :else
        {:type :unknown :payload t})))

;; react-format-observation: io/sh result -> string
(defn react-format-observation [result]
  (let [exit     (:exit result)
        out      (or (:out result) "")
        err      (or (:err result) "")
        combined (if (strings/blank? err) out (cat out "\n" err))
        body     (if (> (count combined) 10000)
                   (cat (subs combined 0 5000)
                        "\n<elided>\n"
                        (subs combined (- (count combined) 5000)))
                   combined)]
    (cat "Exit code: " (str exit) "\n" body)))

;; run: ReAct loop with proper multi-turn messages (mirrors mini-swe-agent DefaultAgent).
;; opts:
;;   string       - task text
;;   :task        - task text (required if opts map)
;;   :max-steps   - max steps before LimitsExceeded (default: 30, 0 = unlimited)
;;   :verbose     - print each step (default: false)
(defn run [opts]
  (let [opts      (if (string? opts) {:task opts} opts)
        task      (or (:task opts) (throw "react/run: :task required"))
        max-steps (or (:max-steps opts) 30)
        verbose   (or (:verbose opts) false)
        system    (react/react-system-prompt)
        init-msgs [{:role "system" :content system}
                   {:role "user"   :content (cat "Task: " task)}]]
    (loop [step 1 messages init-msgs]
      (if (and (> max-steps 0) (>= step max-steps))
        {:exit_status "LimitsExceeded" :submission ""}
        (let [raw      (leaf-llm messages)
              thought  (react/react-extract-thought raw step)
              act-line (react/react-extract-action-line raw step)
              action   (react/react-parse-action act-line)]
          (if verbose
            (do
              (println (cat "\n=== Step " (str step) " ==="))
              (println (cat "Thought: " thought))
              (println (cat "Action:  " act-line))))
          (cond
            (or (= (:type action) :finish) (= act-line ""))
            (do
              (if verbose (println "Observation: [Finish]"))
              {:exit_status "submitted" :submission (:payload action)})

            (= (:type action) :bash)
            (let [result  (io/sh (:payload action))
                  obs     (react/react-format-observation result)
                  msgs'   (conj messages
                                {:role "assistant" :content raw}
                                {:role "user"      :content (cat "Observation " (str step) ": " obs)})]
              (if verbose (println (cat "Observation: " obs)))
              (recur (+ step 1) msgs'))

            :else
            (let [obs   (cat "Unrecognized action: " act-line)
                  msgs' (conj messages
                               {:role "assistant" :content raw}
                               {:role "user"      :content obs})]
              (if verbose (println (cat "Observation: " obs)))
              (recur (+ step 1) msgs'))))))))
