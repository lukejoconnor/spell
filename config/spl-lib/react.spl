;; Hidden ReAct loop implemented entirely in Spell.
;;
;; Public entrypoint:
;;   (react/run prompt-or-opts)
;;
;; The inner model sees plain text only: task, transcript, and a command/finish
;; contract. Spell remains implementation substrate only.

(defn normalize-opts [prompt-or-opts]
  (let [opts (if (string? prompt-or-opts)
               {:task prompt-or-opts}
               prompt-or-opts)
        task (:task opts)
        max-steps-raw (:max-steps opts)
        max-steps (if (number? max-steps-raw) max-steps-raw 30)]
    (when (or (nil? task) (strings/blank? task))
      (throw "react/run: task string required"))
    {:task task
     :max-steps max-steps}))

(defn truncate-middle [text limit]
  (let [text (if (nil? text) "" (str text))
        limit (if (number? limit) limit 4000)
        n (count text)]
    (if (<= n limit)
      text
      (let [head-size (long (/ limit 2))
            tail-size (max 0 (- limit head-size))
            omitted (- n head-size tail-size)]
        (cat (subs text 0 head-size)
             "\n... [" omitted " chars omitted] ...\n"
             (subs text (- n tail-size) n))))))

(defn extract-thought [response action-idx]
  (let [trimmed (strings/trim response)
        thought-idx (strings/index-of trimmed "Thought:")]
    (if (and thought-idx (< thought-idx action-idx))
      (strings/trim (subs trimmed (+ thought-idx 8) action-idx))
      "")))

(defn parse-action [response]
  (let [trimmed (strings/trim response)
        command-marker "Action: Command["
        finish-marker "Action: Finish["
        command-idx (strings/index-of trimmed command-marker)
        finish-idx (strings/index-of trimmed finish-marker)
        marker (cond
                 (and command-idx finish-idx)
                 (if (< command-idx finish-idx) command-marker finish-marker)
                 command-idx command-marker
                 finish-idx finish-marker
                 :else nil)
        action-idx (cond
                     (= marker command-marker) command-idx
                     (= marker finish-marker) finish-idx
                     :else nil)]
    (if (nil? marker)
      {:type :invalid
       :thought ""
       :raw trimmed}
      (let [body-start (+ action-idx (count marker))
            body-end (or (strings/last-index-of trimmed "]")
                         (count trimmed))
            body (if (>= body-end body-start)
                   (strings/trim (subs trimmed body-start body-end))
                   "")
            thought (react/extract-thought trimmed action-idx)]
        {:type (if (= marker command-marker) :command :finish)
         :thought thought
         :value body
         :raw trimmed}))))

(defn format-observation [result]
  (let [out (react/truncate-middle (:out result) 5000)
        err (react/truncate-middle (:err result) 3000)]
    (cat "Exit: " (:exit result) "\n"
         (if (strings/blank? out)
           "Stdout: <empty>\n"
           (cat "Stdout:\n" out "\n"))
         (if (strings/blank? err)
           "Stderr: <empty>"
           (cat "Stderr:\n" err)))))

(defn render-history [history]
  (if (empty? history)
    "None yet.\n"
    (loop [idx 0
           acc ""]
      (if (>= idx (count history))
        acc
        (let [step (nth history idx)
              thought (if (strings/blank? (:thought step))
                        "(none)"
                        (:thought step))]
          (recur (+ idx 1)
                 (cat acc
                      "Step " (+ idx 1) "\n"
                      "Thought: " thought "\n"
                      "Action: Command[" (:command step) "]\n"
                      "Observation:\n"
                      (:observation step) "\n\n")))))))

(defn render-prompt [task history remaining]
  (cat
   "You are a command-line coding agent running a plain-text ReAct loop.\n"
   "Solve the task by alternating a brief Thought with exactly one Action.\n\n"
   "Output format:\n"
   "Thought: <brief reasoning>\n"
   "Action: Command[<one shell command>]\n\n"
   "When you are ready to finish, use:\n"
   "Thought: <brief reasoning>\n"
   "Action: Finish[<final answer>]\n\n"
   "Rules:\n"
   "- Output exactly one Thought line and one Action line.\n"
   "- Use either Command[...] or Finish[...], not both.\n"
   "- Commands must be a single shell command line.\n"
   "- The observation for each command will be provided on the next turn.\n"
   "- Keep Thought concise and focused on the next step.\n\n"
   "Task:\n"
   task "\n\n"
   "Remaining steps: " remaining "\n\n"
   "Previous steps:\n"
   (react/render-history history)
   "Respond with the next step now."))

(defn invalid-format-observation [response]
  (cat
   "Invalid response format.\n"
   "Respond with exactly:\n"
   "Thought: <brief reasoning>\n"
   "Action: Command[<one shell command>]\n"
   "or\n"
   "Thought: <brief reasoning>\n"
   "Action: Finish[<final answer>]\n\n"
   "Previous response:\n"
   (react/truncate-middle response 2000)))

(defn run-loop [task history remaining]
  (if (<= remaining 0)
    "React loop reached max steps without a final answer."
    (let [prompt (react/render-prompt task history remaining)
          response (leaf-llm prompt)
          parsed (react/parse-action response)]
      (if (= (:type parsed) :finish)
        (:value parsed)
        (if (= (:type parsed) :command)
          (let [result (io/sh (:value parsed))
                observation (react/format-observation result)
                step {:thought (:thought parsed)
                      :command (:value parsed)
                      :observation observation}]
            (react/run-loop task (conj history step) (- remaining 1)))
          (let [step {:thought ""
                      :command "FORMAT_ERROR"
                      :observation (react/invalid-format-observation response)}]
            (react/run-loop task (conj history step) (- remaining 1))))))))

(defn run [prompt-or-opts]
  (let [opts (react/normalize-opts prompt-or-opts)]
    (react/run-loop (:task opts) [] (:max-steps opts))))
