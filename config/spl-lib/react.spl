;; React pattern — mini-swe-agent v2 style: native bash tool calling.
;; Matches DefaultAgent from github.com/SWE-agent/mini-swe-agent (v2).
;; Uses leaf-llm-tool which sends a bash tool definition and extracts tool calls.
;; Loaded as react/ namespace via src/spell/react.clj.
;;
;; Usage: (react/run "Fix the failing test in test_foo.py")
;; Returns: {:exit_status "submitted"|"LimitsExceeded" :submission str}

;; react-system-prompt: matches mini-swe mini.yaml system_template
(defn react-system-prompt []
  "You are a helpful assistant that can interact with a computer.")

;; react-instance-template: matches mini-swe mini.yaml instance_template exactly
(defn react-instance-template [task]
  (cat
    "Please solve this issue: " task "\n\n"
    "You can execute bash commands and edit files to implement the necessary changes.\n\n"
    "## Recommended Workflow\n\n"
    "This workflow should be done step-by-step so that you can iterate on your changes and any possible problems.\n\n"
    "1. Analyze the codebase by finding and reading relevant files\n"
    "2. Create a script to reproduce the issue\n"
    "3. Edit the source code to resolve the issue\n"
    "4. Verify your fix works by running your script again\n"
    "5. Test edge cases to ensure your fix is robust\n"
    "6. Submit your changes and finish your work by issuing the following command: `echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT`.\n"
    "   Do not combine it with any other command. <important>After this command, you cannot continue working on this task.</important>\n\n"
    "## Command Execution Rules\n\n"
    "You are operating in an environment where\n\n"
    "1. You issue at least one command\n"
    "2. The system executes the command(s) in a subshell\n"
    "3. You see the result(s)\n"
    "4. You write your next command(s)\n\n"
    "Each response should include:\n\n"
    "1. **Reasoning text** where you explain your analysis and plan\n"
    "2. At least one tool call with your command\n\n"
    "**CRITICAL REQUIREMENTS:**\n\n"
    "- Your response SHOULD include reasoning text explaining what you're doing\n"
    "- Your response MUST include AT LEAST ONE bash tool call\n"
    "- Directory or environment variable changes are not persistent. Every action is executed in a new subshell.\n"
    "- However, you can prefix any action with `MY_ENV_VAR=MY_VALUE cd /path/to/working/dir && ...` or write/load environment variables from files\n"
    "- Submit your changes and finish your work by issuing the following command: `echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT`.\n"
    "  Do not combine it with any other command. <important>After this command, you cannot continue working on this task.</important>\n\n"
    "Example of a CORRECT response:\n"
    "<example_response>\n"
    "I need to understand the structure of the repository first. Let me check what files are in the current directory to get a better understanding of the codebase.\n\n"
    "[Makes bash tool call with {\"command\": \"ls -la\"} as arguments]\n"
    "</example_response>\n\n"
    "<system_information>\n"
    "Darwin 23.2.0 Darwin Kernel Version 23.2.0: Wed Nov 15 21:59:33 PST 2023; root:xnu-10002.61.3~2/RELEASE_ARM64_T8112 arm64\n"
    "</system_information>\n\n"
    "## Useful command examples\n\n"
    "### Create a new file:\n\n"
    "```bash\n"
    "cat <<'EOF' > newfile.py\n"
    "import numpy as np\n"
    "hello = \"world\"\n"
    "print(hello)\n"
    "EOF\n"
    "```\n\n"
    "### Edit files with sed:\n\n"
    "<important>\n"
    "You are on MacOS. For all the below examples, you need to use `sed -i ''` instead of `sed -i`.\n"
    "</important>\n\n"
    "```bash\n"
    "# Replace all occurrences\n"
    "sed -i '' 's/old_string/new_string/g' filename.py\n\n"
    "# Replace only first occurrence\n"
    "sed -i '' 's/old_string/new_string/' filename.py\n\n"
    "# Replace first occurrence on line 1\n"
    "sed -i '' '1s/old_string/new_string/' filename.py\n\n"
    "# Replace all occurrences in lines 1-10\n"
    "sed -i '' '1,10s/old_string/new_string/g' filename.py\n"
    "```\n\n"
    "### View file content:\n\n"
    "```bash\n"
    "# View specific lines with numbers\n"
    "nl -ba filename.py | sed -n '10,20p'\n"
    "```\n\n"
    "### Any other command you want to run\n\n"
    "```bash\n"
    "anything\n"
    "```"))

;; react-format-observation: io/sh result -> JSON string (matches mini-swe observation_template)
(defn react-format-observation [result]
  (let [exit     (:exit result)
        out      (or (:out result) "")
        err      (or (:err result) "")
        combined (if (strings/blank? err) out (cat out "\n" err))]
    (if (> (count combined) 10000)
      (cat "{\"returncode\": " (str exit)
           ", \"output_head\": " (pr-str (subs combined 0 5000))
           ", \"output_tail\": " (pr-str (subs combined (- (count combined) 5000)))
           ", \"elided_chars\": " (str (- (count combined) 10000))
           ", \"warning\": \"Output too long.\"}")
      (cat "{\"returncode\": " (str exit)
           ", \"output\": " (pr-str combined) "}"))))

;; react-submitted?: check if command output signals task completion
(defn react-submitted? [obs]
  (not (nil? (strings/index-of obs "COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT"))))

;; run: mini-swe-agent v2 style ReAct loop with native bash tool calling.
;; opts:
;;   string       - task text
;;   :task        - task text (required if opts map)
;;   :max-steps   - max steps before LimitsExceeded (default: 30, 0 = unlimited)
;;   :verbose     - print each step (default: false)
(defn run [opts]
  (let [opts      (if (string? opts) {:task opts} opts)
        task      (or (:task opts) (throw "react/run: :task required"))
        max-steps (or (:max-steps opts) 30)
        verbose   (or (:verbose opts) false)
        system    (react/react-system-prompt)
        instance  (react/react-instance-template task)
        init-msgs [{:role "system" :content system}
                   {:role "user"   :content instance}]]
    (loop [step 1 messages init-msgs]
      (if (and (> max-steps 0) (>= step max-steps))
        {:exit_status "LimitsExceeded" :submission ""}
        (let [result    (leaf-llm-tool messages)
              command   (:command result)
              tool-id   (:tool_call_id result)
              asst-msg  (:assistant-message result)]
          (if verbose
            (do
              (println (cat "\n=== Step " (str step) " ==="))
              (println (cat "Command: " command))))
          ;; Execute command
          (let [sh-result (io/sh command)
                obs       (react/react-format-observation sh-result)
                msgs'     (conj messages
                                asst-msg
                                {:role        "user"
                                 :content     [{:type         "tool_result"
                                                :tool_use_id  tool-id
                                                :content      obs}]})]
            (if verbose (println (cat "Observation: " obs)))
            (if (react/react-submitted? obs)
              ;; Exit process to prevent Spell runtime orphan box from re-running.
              ;; TODO: fix make-root-fn to support one-shot mode without System/exit.
              ;; See: runtime/make-root-fn always spawns orphan after inside-fn returns,
              ;; causing the program to re-execute indefinitely.
              (do (println (str "{:exit_status \"submitted\", :submission " (pr-str command) "}"))
                  (System/exit 0))
              (recur (+ step 1) msgs'))))))))
