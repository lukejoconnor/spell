;; Installable definition data; reading/installing never runs this source.
{:doc
 "Shared in-run mailing-list board. Install/reuse definitions separately from explicit one-time initialization of :mailing-list state.",
 :functions
 {:init
  {:doc
   "Initialize board state once from an options map; duplicate initialization errors without replacing any state. Installation alone never initializes or resets the board.",
   :requires [agents globals],
   :source
   (fn
    [options]
    (let
     [ml-owner
      (agents/current-handle)
      ml-config
      (merge
       {:retention 200,
        :page-size 20,
        :max-lists 32,
        :max-subscribers 32,
        :max-message-chars 16000}
       options)
      ml-initial
      {:owner ml-owner, :version 1, :config ml-config, :epoch 0, :lists {}, :last-result nil}]
     (map
      (fn
       [[k upper]]
       (when
        (not (and (integer? (get ml-config k)) (<= 1 (get ml-config k) upper)))
        (throw (str "mailing-list: invalid bound " k))))
      [[:retention 2000]
       [:page-size 100]
       [:max-lists 128]
       [:max-subscribers 64]
       [:max-message-chars 65536]])
     (when
      (seq
       (remove
        #{:max-lists :page-size :retention :max-message-chars :max-subscribers}
        (keys options)))
      (throw "mailing-list: unknown option"))
     (globals/update
      :mailing-list
      (fn
       [ml-existing]
       (when (some? ml-existing) (throw "mailing-list: already initialized"))
       ml-initial))
     {:owner ml-owner, :global :mailing-list, :ready true}))},
  :call
  {:doc
   "Dispatch a board operation and arguments map. Resolve current module helpers through patterns/call; mutations return the exact successful globals/update snapshot result. Sends and child launches happen outside retryable transactions.",
   :requires [agents globals patterns],
   :source
   (fn
    [ml-operation ml-arguments]
    (when (not (map? ml-arguments)) (throw "mail: arguments must be a map"))
    (let
     [ml-state
      (globals/get :mailing-list)
      ml-args
      (assoc ml-arguments :agent (get ml-arguments :agent (agents/current-handle)))]
     (when (not ml-state) (throw "mail: board not initialized; designate exactly one initializer"))
     (case
      ml-operation
      :info
      {:owner (:owner ml-state),
       :config (:config ml-state),
       :module-functions (vec (keys (:functions (patterns/source :mailing-list))))}
      :lists
      (map
       (fn
        [[k ls]]
        {:list k,
         :description (:description ls),
         :high-water (dec (:next ls)),
         :retained (count (:messages ls)),
         :subscribers (vec (keys (:subscriptions ls)))})
       (:lists ml-state))
      :digest
      (patterns/call :mailing-list :digest ml-state ml-args)
      :message
      (let
       [ls (get-in ml-state [:lists (:list ml-args)]) id (:id ml-args)]
       (when (not ls) (throw "mail: unknown list"))
       (when
        (not (and (integer? id) (pos? id) (< id (:next ls))))
        (throw "mail: unknown message ID"))
       (let
        [m (first (filter (fn [m] (= id (:id m))) (:messages ls)))]
        {:list (:list ml-args), :id id, :message m, :expired? (nil? m)}))
      :notify
      (let
       [ls (get-in ml-state [:lists (:list ml-args)]) id (get ml-args :id (dec (:next ls)))]
       (when (not ls) (throw "mail: unknown list"))
       (when
        (not (and (integer? id) (<= 0 id (dec (:next ls)))))
        (throw "mail: invalid notification watermark"))
       {:list (:list ml-args),
        :id id,
        :deliveries
        (patterns/call
         :mailing-list
         :deliver
         (vec (keys (:subscriptions ls)))
         {:kind :mailing-list, :list (:list ml-args), :through id})})
      :post!
      (let
       [posted (patterns/call :mailing-list :call :post ml-args)]
       (assoc
        posted
        :deliveries
        (patterns/call
         :mailing-list
         :deliver
         (:targets posted)
         {:kind :mailing-list, :list (:list posted), :through (:id posted)})))
      :spawn
      (let
       [task (:task ml-args) handle (:handle ml-args) lists (:lists ml-args)]
       (when
        (not
         (and
          (string? task)
          (keyword? handle)
          (vector? lists)
          (<= (count lists) (get-in ml-state [:config :max-lists]))
          (every? (fn [k] (contains? (:lists ml-state) k)) lists)))
        (throw "mail: spawn needs :task string, :handle keyword, and existing :lists vector"))
       (let
        [teaching
         (str
          "You are a mailing-list board worker. Bootstrap installed/reused the :mailing-list module; patterns/install never resets the board. Do NOT call patterns/call :mailing-list :init. \nContext discipline: avoid the prune-evidence-then-rediscover antipattern. Before pruning a tool result, persist the exact evidence, actual effect receipts and next-action checkpoint needed for the artifact; retrieve retained or stored output instead of repeating effects.\n"
          "Your subscriptions are already installed before this generation. "
          "Use quoted trailing effects, e.g. '(!call-now page (patterns/call :mailing-list :call :digest {:list :research})). "
          "Use the actual list names: "
          (pr-str lists)
          ". "
          "Digest requires singular keyword :list; call once per list, never :lists. "
          "Digest is read-only; after processing its messages and visible :gap, "
          "acknowledge exactly its :token with patterns/call :mailing-list :call :ack {:token (:token page)}. "
          "Post compact summaries with :post; :post! explicitly awakens every subscriber. "
          "Retrieve full evidence with :message {:list k :id n}. "
          "Read (!describe skills :mailing-list) for progressive guidance when available. "
          "Communicate via normal tracked agents requests; do not poll or invent blocking waits. "
          "Task: "
          task)
         bootstrap
         (list
          'quine
          'completion
          (list
           'eval
           (list
            'do
            (list
             'quote
             (list
              'let
              ['ml-onboarding-failure
               (list
                'try
                (list
                 'do
                 (list 'patterns/install :mailing-list)
                 (list
                  'patterns/call
                  :mailing-list
                  :call
                  :subscribe-many
                  {:agent handle, :lists lists, :from (get ml-args :from :earliest)})
                 nil)
                (list
                 'catch
                 'ml-onboarding-error
                 {:spell/child-failure true,
                  :handle handle,
                  :phase :onboarding,
                  :error (list 'str 'ml-onboarding-error)}))]
              (list
               'if
               'ml-onboarding-failure
               'ml-onboarding-failure
               (list '!llm-self (wrap-cat teaching) {:receive? true})))))))]
        {:handle handle,
         :onboarding :pending,
         :edge (agents/spawn-ask (pr-str bootstrap) handle)}))
      (let
       [updated
        (globals/update
         :mailing-list
         (fn
          [ml-current]
          (let
           [[next-board result]
            (patterns/call :mailing-list :change ml-current ml-operation ml-args)]
           (assoc next-board :last-result result))))]
       (:last-result updated)))))},
  :change
  {:doc
   "Pure retryable board transition [board operation arguments] -> [next-board result]. No sends, spawns or global mutations; customization must preserve transaction purity.",
   :requires [patterns],
   :source
   (fn
    [b op a]
    (let
     [k (:list a) ls (get-in b [:lists k]) who (:agent a)]
     (case
      op
      :create
      (do
       (when
        (or (not (keyword? k)) (> (count (str k)) 128))
        (throw "mail: :list must be a short keyword"))
       (when ls (throw "mail: list already exists"))
       (when
        (>= (count (:lists b)) (get-in b [:config :max-lists]))
        (throw "mail: list limit reached"))
       (when
        (or (not (string? (:description a))) (> (count (:description a)) 1000))
        (throw "mail: description must be a string of at most 1000 characters"))
       [(assoc-in
         b
         [:lists k]
         {:description (:description a), :next 1, :messages [], :subscriptions {}})
        {:list k, :created true}])
      :subscribe
      (do
       (when (not ls) (throw "mail: unknown list"))
       (when
        (or (not (keyword? who)) (> (count (str who)) 128))
        (throw "mail: :agent must be a short handle keyword"))
       (when
        (not (contains? #{:latest :earliest} (get a :from :latest)))
        (throw "mail: :from must be :latest or :earliest"))
       (if-let
        [sub (get-in ls [:subscriptions who])]
        [b (assoc sub :list k :agent who)]
        (do
         (when
          (>= (count (:subscriptions ls)) (get-in b [:config :max-subscribers]))
          (throw "mail: subscriber limit reached"))
         (let
          [epoch
           (inc (:epoch b))
           cursor
           (if (= :earliest (:from a)) 0 (dec (:next ls)))
           sub
           {:epoch epoch, :cursor cursor}]
          [(-> b (assoc :epoch epoch) (assoc-in [:lists k :subscriptions who] sub))
           (assoc sub :list k :agent who)]))))
      :subscribe-many
      (do
       (when
        (or (not (vector? (:lists a))) (> (count (:lists a)) (get-in b [:config :max-lists])))
        (throw "mail: :lists must be a bounded vector"))
       (loop
        [state b todo (:lists a) results []]
        (if
         (empty? todo)
         [state {:agent who, :subscriptions results}]
         (let
          [[next-state result]
           (patterns/call :mailing-list :change state :subscribe (assoc a :list (first todo)))]
          (recur next-state (rest todo) (conj results result))))))
      :unsubscribe
      (do
       (when (not ls) (throw "mail: unknown list"))
       [(update-in b [:lists k :subscriptions] dissoc who)
        {:list k, :agent who, :unsubscribed true}])
      :post
      (do
       (when (not ls) (throw "mail: unknown list"))
       (when
        (or (not (string? (:summary a))) (empty? (:summary a)) (> (count (:summary a)) 500))
        (throw "mail: :summary must contain 1-500 characters"))
       (when
        (and (:thread a) (or (not (string? (:thread a))) (> (count (:thread a)) 128)))
        (throw "mail: :thread must be a short string"))
       (when
        (and
         (:reply-to a)
         (not (and (integer? (:reply-to a)) (pos? (:reply-to a)) (< (:reply-to a) (:next ls)))))
        (throw "mail: :reply-to must reference an earlier ID in this list"))
       (let
        [id
         (:next ls)
         msg
         (assoc
          (select-keys a [:summary :body :thread :reply-to :provenance :tags])
          :id
          id
          :author
          who)
         all
         (conj (:messages ls) msg)
         keep-n
         (get-in b [:config :retention])]
        (when
         (> (count (pr-str msg)) (get-in b [:config :max-message-chars]))
         (throw "mail: message too large; store evidence elsewhere and post a reference"))
        [(->
          b
          (assoc-in [:lists k :next] (inc id))
          (assoc-in [:lists k :messages] (vec (drop (max 0 (- (count all) keep-n)) all))))
         {:list k, :id id, :targets (vec (keys (:subscriptions ls)))}]))
      :ack
      (let
       [token
        (:token a)
        tk
        (:list token)
        agent
        (:agent token)
        sub
        (get-in b [:lists tk :subscriptions agent])
        through
        (:through token)
        high
        (dec (get-in b [:lists tk :next] 1))]
       (when (nil? token) (throw "mail: :ack requires {:token page-token}"))
       (when
        (or (nil? sub) (not= (:epoch sub) (:epoch token)) (not= who agent))
        (throw "mail: stale subscription token or wrong agent"))
       (when
        (not (and (integer? through) (<= 0 through high)))
        (throw "mail: invalid acknowledgement watermark"))
       (let
        [cursor (max (:cursor sub) through)]
        [(assoc-in b [:lists tk :subscriptions agent :cursor] cursor)
         {:list tk, :agent agent, :cursor cursor}]))
      (throw (str "mail: unknown change " op)))))},
  :digest
  {:doc
   "Read a board snapshot and argument map with required keyword :list (singular, one call per list; :lists is unsupported); return bounded summaries, visible retention gap and exact acknowledgement token without mutation.",
   :requires [],
   :source
   (fn
    [b a]
    (when (not (map? a)) (throw "mail: arguments must be a map"))
    (when
     (contains? a :lists)
     (throw "mail: :digest accepts singular :list, not :lists; call once per list, e.g. (patterns/call :mailing-list :call :digest {:list :research})"))
    (when
     (not (keyword? (:list a)))
     (throw "mail: :digest requires a keyword :list, e.g. (patterns/call :mailing-list :call :digest {:list :research})"))
    (let
     [k
      (:list a)
      who
      (:agent a)
      ls
      (get-in b [:lists k])
      sub
      (get-in ls [:subscriptions who])
      limit
      (get a :limit (get-in b [:config :page-size]))]
     (when
      (not ls)
      (throw
       (str "mail: unknown list " (pr-str k)
            "; choose an existing list with (patterns/call :mailing-list :call :lists {}) or create it with (patterns/call :mailing-list :call :create {:list "
            (pr-str k) " :description \"Purpose\"}); then call (patterns/call :mailing-list :call :digest {:list " (pr-str k) "})")))
     (when
      (not sub)
      (throw
       (str "mail: subscribe before reading a digest for " (pr-str k)
            "; call (patterns/call :mailing-list :call :subscribe {:list " (pr-str k)
            "}), then (patterns/call :mailing-list :call :digest {:list " (pr-str k) "})")))
     (when (not (and (integer? limit) (<= 1 limit 100))) (throw "mail: :limit must be 1-100"))
     (let
      [cursor
       (:cursor sub)
       high
       (dec (:next ls))
       oldest
       (if (seq (:messages ls)) (:id (first (:messages ls))) (:next ls))
       page
       (vec (take limit (filter (fn [m] (> (:id m) cursor)) (:messages ls))))
       through
       (if (seq page) (:id (last page)) cursor)]
      {:list k,
       :agent who,
       :cursor cursor,
       :high-water high,
       :gap (when (< cursor (dec oldest)) {:from (inc cursor), :through (dec oldest)}),
       :messages (map (fn [m] (select-keys m [:id :author :summary :thread :reply-to])) page),
       :remaining (- high through),
       :token {:list k, :agent who, :epoch (:epoch sub), :through through}})))},
  :deliver
  {:doc
   "Attempt each target notice once outside transactions; return per-recipient sent/error receipts. Acceptance is not evidence of processing.",
   :requires [agents],
   :source
   (fn
    [targets notice]
    (map
     (fn
      [target]
      (try
       (do (agents/send target notice) {:agent target, :sent true})
       (catch e {:agent target, :sent false, :error (str e)})))
     targets))}}}
