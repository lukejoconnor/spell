;; Spell Pattern Library
;;
;; Reusable patterns for common Spell idioms.
;; Available as patterns namespace: (patterns/call-now result 'name)

;; ---------------------------------------------------------------------------
;; call-now — tool use with continuation
;; ---------------------------------------------------------------------------
;; Evaluates a tool, binds the result in the completion, and extends to a
;; child LLM that can see the result and continue reasoning.
;;
;; (patterns/call-now (tools/bash "ls") 'files)
;; (patterns/call-now (:out (tools/bash "wc -l data.csv")) 'line-count)
;;
;; How it works:
;; 1. The tool argument is evaluated (bash, read-file, etc.)
;; 2. The result is formatted as (def name <value>) and appended to completion
;; 3. A child LLM receives the extended prefix and continues
;;
;; Idempotent in extensions: when the child re-evaluates call-now, it detects
;; that the binding already exists in the completion and returns early. The tool
;; arg IS re-evaluated (Lisp semantics), but no new extension is created.
;;
;; Requires: completion binding (from quine preamble in NL prompts)
;;
;; For side-effecting tools, pre-compute:
;;   (def r (tools/bash "rm ...")) (patterns/call-now r 'result)
;; This way the side effect only runs once (before call-now).

(defn call-now [result name]
  (if (strings/includes? completion (cat "(def " (str name) " "))
    result
    (llm (cat (reopen completion) "(def " (str name) " " (pr-str result) ") "))))
