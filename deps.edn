{:paths ["src"]
 :deps {org.clojure/data.json {:mvn/version "2.5.0"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.jsoup/jsoup {:mvn/version "1.18.1"}}
 :aliases {:dev {:extra-paths ["dev"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"
                              "-e" "known-bug"
                              "-e" "real-provider"]}
           :test-real-provider {:extra-paths ["test"]
                                :extra-deps {io.github.cognitect-labs/test-runner
                                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                                :main-opts ["-m" "cognitect.test-runner"
                                            "-n" "spell.cache-real-provider-test"]}
           ;; Fast tests only — pure/unit tests, no concurrency or I/O (~1s)
           :test-fast {:extra-paths ["test"]
                       :extra-deps {io.github.cognitect-labs/test-runner
                                    {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                       :main-opts ["-m" "cognitect.test-runner"
                                   "-n" "spell.parse-test"
                                   "-n" "spell.grammar-test"
                                   "-n" "spell.stdlib-test"
                                   "-n" "spell.eval-test"
                                   "-n" "spell.llm-test"
                                   "-n" "spell.agent-test"
                                   "-n" "spell.web-test"
                                   "-n" "spell.api-test"
                                   "-n" "spell.trace-test"]}
           ;; Slow tests — concurrency, I/O, filesystem watchers (~12s)
           :test-slow {:extra-paths ["test"]
                       :extra-deps {io.github.cognitect-labs/test-runner
                                    {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                       :main-opts ["-m" "cognitect.test-runner"
                                   "-n" "spell.core-test"
                                   "-n" "spell.io-test"
                                   "-n" "spell.runtime-test"
                                   "-n" "spell.globals-test"
                                   "-n" "spell.user-test"]}
           :run {:main-opts ["-m" "spell.cli"]}
           :uberjar {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
                     :exec-fn hf.depstar/uberjar
                     :exec-args {:aot true
                                 :jar "spell.jar"
                                 :main-class "spell.cli"}}}}
